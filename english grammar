<script>
function checkAnswers() {

    let correctAnswers = [
        "b", "c", "b", "a", "b",
        "a", "b", "b", "a", "a",
        "b", "c", "b", "a", "b",
        "a", "a", "b", "b", "c",
        "a", "b", "b", "b", "b",
        "b", "c", "c", "b", "a"
    ];

    let score = 0;
    let unanswered = 0;

    for (let i = 1; i <= 30; i++) {
        let answer = document.querySelector('input[name="q' + i + '"]:checked');

        if (!answer) {
            unanswered++;
        } else if (answer.value === correctAnswers[i - 1]) {
            score++;
        }
    }

    let name = document.getElementById("name").value;

    if (name === "") {
        name = "Student";
    }

    let percentage = (score / 30) * 100;

    document.getElementById("result").innerHTML =
        name + ", your result: " + score + "/30<br>" +
        "Percentage: " + percentage.toFixed(1) + "%<br>" +
        "Unanswered: " + unanswered;
}
</script>

